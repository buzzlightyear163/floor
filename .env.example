# Kopiera till .env.local och justera.

# Demo-plånböcker, demo-konto utan Phantom och simulerade insättningar.
# Sätt till false först när riktig backend finns (TODO(backend)).
VITE_DEMO_MODE=true

# Simulerade trades för traders on shift (fyller Analytics / Ledger / P&L).
VITE_DEMO_TRADES=true

# Publik statistik (firms open, traders hired, leaderboard, The Floor).
# Default: lokal fixture i public/api/stats.json
VITE_STATS_URL=/api/stats.json
